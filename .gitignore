.expo/
ios/
android/
*.jks
*.keystore
keystore.properties
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Logs
# 先頭の / が無いと、アプリのルートディレクトリ（app/.../logs/）まで
# 無視してしまう。実際に WBS 1.8 の画面がコミットから漏れた。
/logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Database
*.db
*.db-shm
*.db-wal
*.sqlite

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/
.vitest/

# E2E generated artifacts
e2e/android-e2e-result.json
e2e/screenshots/
e2e/ui-dumps/
e2e/ui*.xml

# Local on-device LLM artifacts
apps/mobile/android/app/src/main/assets/models/*.bin
apps/mobile/android/app/src/main/assets/models/*.task
!apps/mobile/android/app/src/main/assets/models/README.md

# Temporary
tmp/
temp/
Temp/

# Claude Code
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
chat.json
nul

# ビルド成果物（リポジトリに入れない）
# `eas build --local` は apps/mobile/ 直下に build-<epoch>.ipa を吐く。20MB 級で、
# 無視していないと `git add -A` で入る（2026-08-27 に Mac 側が気づいた）。
# android/ は既にプロジェクトごと無視しているので aab/apk は対象外。
apps/mobile/build-*.ipa
*.ipa
