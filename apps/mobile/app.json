{
  "expo": {
    "name": "さいえん手帳",
    "slug": "saien-techo",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "saientecho",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F8F1",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saientecho.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.saientecho.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F8F1"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withSaienUploadSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20"
          }
        }
      ],
      "./plugins/withKotlinMetadataSkip",
      [
        "expo-image-picker",
        {
          "photosPermission": "栽培や収穫の写真を選択するために写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "栽培や収穫の写真を撮影するためにカメラを使用します。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2633806931583277~7473584300",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "広告の表示回数の制御と不正防止のために利用します。"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "owner": "keisato848"
  }
}
